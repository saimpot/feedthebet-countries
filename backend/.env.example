APP_NAME=FeedTheBet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# lax is required: the cookie must survive the redirect back from Auth0 (top-level GET)
SESSION_SAME_SITE=lax
# Set to true when served over https
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Auth0 (Regular Web Application, server-side session).
# Dashboard: Allowed Callback URLs = ${APP_URL}/callback, Allowed Logout URLs = ${APP_URL}
# redirect_uri is derived from APP_URL (+ /callback), so APP_URL must match what the browser uses.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Encrypts the Auth0 SDK session payload. Falls back to APP_KEY when empty;
# generate a dedicated one with `openssl rand -hex 32`.
AUTH0_COOKIE_SECRET=

# Countries module. Without an API key the bundled static dataset is used.
# Get a free key (1000 requests/month) at https://restcountries.com/sign-up
# COUNTRIES_DRIVER=static
COUNTRIES_RESTCOUNTRIES_API_KEY=
# COUNTRIES_RESTCOUNTRIES_URL=https://api.restcountries.com
# COUNTRIES_CACHE_ENABLED=true
# COUNTRIES_CACHE_STORE=
